# deploy/garmin-pace-https.service runs the bundled TLS proxy with separate private state.
# The installer generates its Caddyfile and validates the backend before enabling HTTPS.
[Unit]
Description=Garmin Pace public HTTPS
Wants=network-online.target garmin-pace.service
After=network-online.target garmin-pace.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
User=pace-https
Group=pace-https
ExecStart=/usr/local/lib/garmin-pace/caddy run --config /etc/garmin-pace/Caddyfile --adapter caddyfile
Environment=XDG_DATA_HOME=/var/lib/garmin-pace-https
Environment=XDG_CONFIG_HOME=/var/lib/garmin-pace-https
Environment=GOMEMLIMIT=64MiB
Environment=GOMAXPROCS=2
StateDirectory=garmin-pace-https
StateDirectoryMode=0700
WorkingDirectory=/var/lib/garmin-pace-https
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStartSec=45
TimeoutStopSec=20
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/garmin-pace-https
LimitCORE=0
LimitNOFILE=256
TasksMax=64
MemoryMax=128M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
